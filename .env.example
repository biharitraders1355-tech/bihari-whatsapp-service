# ─── MongoDB (same connection as your Python backend) ─────────────────────────
MONGO_URL=mongodb://localhost:27017
MONGO_DB=biharitraders

# ─── Baileys auth session storage path ────────────────────────────────────────
# Sessions are saved here so you only scan QR once
AUTH_DIR=./auth_session

# ─── Message sending settings ─────────────────────────────────────────────────
# Delay (ms) between each message to avoid rate-limiting (recommended: 2000-5000)
SEND_DELAY_MS=3000

# How often (ms) to poll the MongoDB queue for new messages (default: 5 seconds)
POLL_INTERVAL_MS=5000

# ─── HTTP API port (optional — for QR code endpoint + health check) ───────────
HTTP_PORT=3001

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Render self-ping (prevents free-tier spin-down) ─────────────────────────
# Set this to your Render service's public URL so the app pings itself every
# 14 minutes and stays warm. Leave blank on paid plans or local dev.
# Example: https://bihari-whatsapp-service.onrender.com
SELF_PING_URL=
PING_INTERVAL_MS=840000
